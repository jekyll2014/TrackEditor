<Window x:Class="TrackEditor.AnalyzeRaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyze Race Ability" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinHeight="480" MinWidth="480">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Learn the athlete's speed-vs-terrain behaviour from one or more recorded tracks. Only timestamped tracks can be used; tick the ones to include."/>

        <ListBox x:Name="TracksList" Grid.Row="1" Margin="0,0,0,8">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!-- Traffic-light dot: green/yellow/red by similarity to the target; transparent with no target. -->
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding SimBrush}"/>
                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding CanUse}"
                                  Content="{Binding Label}" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <CheckBox x:Name="ChkUseHr" Content="Use heart rate to calibrate fatigue (when present)"
                      IsChecked="True" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Fatigue driven by:" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbDriver" Width="200">
                    <ComboBoxItem Content="Cumulative ascent" Tag="CumAscent" IsSelected="True"/>
                    <ComboBoxItem Content="Elapsed time" Tag="Elapsed"/>
                    <ComboBoxItem Content="Distance" Tag="Distance"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="ChkNormalize" Content="Normalize each track to its own pace before pooling"
                      IsChecked="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="RunButton" Content="Analyze" Width="100" Click="Run_Click"/>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/>
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="ReportText" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Background="#FAFAFA" Text="Report appears here after analysis."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ExportButton" Content="Export Model…" Width="120" IsEnabled="False" Click="Export_Click"/>
            <Button Content="Close" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
