<Window x:Class="TrackEditor.ApplyRaceModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Race Model" Height="780" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinHeight="600" MinWidth="500">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   x:Name="TargetText"
                   Text="Predict the race flow on the selected track by applying a saved race model."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ImportButton" Content="Import Model…" Width="120" Click="Import_Click"/>
            <TextBlock x:Name="ModelText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"
                       Text="No model loaded." TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Start time (HH:mm):" VerticalAlignment="Center" Width="130"/>
                <TextBox x:Name="TxtStart" Width="80" Text="08:00"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Surface / conditions:" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbSurface" Width="220">
                    <ComboBoxItem Content="As modelled (1.00×)" Tag="1.0" IsSelected="True"/>
                    <ComboBoxItem Content="Fast / dry (1.05×)" Tag="1.05"/>
                    <ComboBoxItem Content="Soft / muddy (0.90×)" Tag="0.90"/>
                    <ComboBoxItem Content="Technical / rocky (0.80×)" Tag="0.80"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="InferSurfaceButton" Content="Infer surface from routing…" Width="200"
                        Click="InferSurface_Click"/>
                <TextBlock x:Name="SurfaceStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"
                           TextWrapping="Wrap" Text="Optional: adopt OSM surface where the route hugs the track."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Effort:" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbEffort" Width="220" SelectedIndex="2">
                    <ComboBoxItem Content="Easy (×0.88)"/>
                    <ComboBoxItem Content="Steady (×0.94)"/>
                    <ComboBoxItem Content="Race (×1.00)"/>
                    <ComboBoxItem Content="All-out (×1.04)"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="ChkAltitude" Content="Apply altitude derate above reference elevation" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkCalibrate" Content="Calibrate pace to my recent race (Riegel)" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkCap" Content="Cap pace to my sustainable ceiling" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkLoad" Content="Apply pack / poles climb-cost" Margin="0,2,0,0"/>

            <Expander x:Name="ProfileExpander" Header="Athlete profile (saved for next time)" Margin="0,8,0,0">
                <Grid Margin="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mass (kg)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtMass" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Age" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="3" x:Name="TxtAge" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HRmax" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtHrMax" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Resting HR" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TxtRestHr" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="LTHR" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtLthr" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Pack (kg)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="3" x:Name="TxtPack" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sex" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CmbSex" Margin="0,0,12,4" SelectedIndex="0">
                        <ComboBoxItem Content="—"/>
                        <ComboBoxItem Content="Female"/>
                        <ComboBoxItem Content="Male"/>
                    </ComboBox>
                    <CheckBox  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ChkPoles"
                               Content="Trekking poles" VerticalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Recent race (km)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtRaceKm" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="in (h:mm:ss)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="4" Grid.Column="3" x:Name="TxtRaceTime" Margin="0,0,0,4"/>
                </Grid>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="RunButton" Content="Predict" Width="100" Click="Run_Click" IsEnabled="False"/>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Prediction" FontWeight="Bold" Margin="0,4,0,4"/>

        <TextBox x:Name="ReportText" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Background="#FAFAFA"
                 Text="Import a model and press Predict."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add Predicted Track" Width="150" IsEnabled="False" Click="Add_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
