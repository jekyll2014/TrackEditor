<Window x:Class="TrackEditor.ApplyRaceModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ApplyRaceModelTitle}" Height="780" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinHeight="600" MinWidth="500">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   x:Name="TargetText"
                   Text="{DynamicResource DescApplyRaceModel}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ImportButton" Content="{DynamicResource BtnImportModel}" Width="120" Click="Import_Click"/>
            <Button x:Name="CreateProfileButton" Content="{DynamicResource BtnCreateProfile}" Width="120" Margin="8,0,0,0"
                    Click="CreateProfile_Click"
                    ToolTip="Fit a new model from your recorded tracks, with the ones most like this target highlighted"/>
            <TextBlock x:Name="ModelText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"
                       Text="{DynamicResource LblNoModel}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource LblSport}" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbSport" Width="220" SelectionChanged="CmbSport_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource SportRunning}" Tag="Running" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource SportRoadBike}" Tag="CyclingRoad"/>
                    <ComboBoxItem Content="{DynamicResource SportXCBike}" Tag="CyclingXC"/>
                </ComboBox>
                <TextBlock x:Name="SportHint" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888"
                           FontSize="11" Text="{DynamicResource SportHintModel}" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource LblStartTime}" VerticalAlignment="Center" Width="130"/>
                <TextBox x:Name="TxtStart" Width="80" Text="08:00"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource LblSurface}" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbSurface" Width="220">
                    <ComboBoxItem Content="{DynamicResource SurfaceModelled}" Tag="1.0" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource SurfaceFast}" Tag="1.05"/>
                    <ComboBoxItem Content="{DynamicResource SurfaceSoft}" Tag="0.90"/>
                    <ComboBoxItem Content="{DynamicResource SurfaceTech}" Tag="0.80"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="InferSurfaceButton" Content="{DynamicResource BtnInferSurface}" Width="200"
                        Click="InferSurface_Click"/>
                <TextBlock x:Name="SurfaceStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"
                           TextWrapping="Wrap" Text="{DynamicResource DescInferSurface}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource LblEffort}" VerticalAlignment="Center" Width="130"/>
                <ComboBox x:Name="CmbEffort" Width="220" SelectedIndex="2">
                    <ComboBoxItem Content="{DynamicResource EffortEasy}"/>
                    <ComboBoxItem Content="{DynamicResource EffortSteady}"/>
                    <ComboBoxItem Content="{DynamicResource EffortRace}"/>
                    <ComboBoxItem Content="{DynamicResource EffortAllOut}"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="ChkAltitude" Content="{DynamicResource ChkAltitudeDerate}" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkCalibrate" Content="{DynamicResource ChkCalibrate}" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkCap" Content="{DynamicResource ChkCap}" Margin="0,2,0,0"/>
            <CheckBox x:Name="ChkLoad" Content="{DynamicResource ChkLoad}" Margin="0,2,0,0"/>

            <Expander x:Name="ProfileExpander" Header="{DynamicResource ProfileExpander}" Margin="0,8,0,0">
                <Grid Margin="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LblMassKg}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtMass" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource LblAge}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="3" x:Name="TxtAge" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LblHrMax}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtHrMax" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource LblRestHr}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TxtRestHr" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LblLthr}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtLthr" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource LblPackKg}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="3" x:Name="TxtPack" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LblSex}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CmbSex" Margin="0,0,12,4" SelectedIndex="0">
                        <ComboBoxItem Content="—"/>
                        <ComboBoxItem Content="{DynamicResource SexFemale}"/>
                        <ComboBoxItem Content="{DynamicResource SexMale}"/>
                    </ComboBox>
                    <CheckBox  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ChkPoles"
                               Content="{DynamicResource ChkPoles}" VerticalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LblRecentRaceKm}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtRaceKm" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{DynamicResource LblInHms}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="4" Grid.Column="3" x:Name="TxtRaceTime" Margin="0,0,0,4"/>
                </Grid>
            </Expander>

            <Expander x:Name="CyclingExpander" Header="{DynamicResource CyclingPhysicsExpander}"
                      Margin="0,8,0,0" Visibility="Collapsed">
                <Grid Margin="6,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LblFtpW}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtFtp" Margin="0,0,0,4"
                               TextChanged="TxtFtp_TextChanged"
                               ToolTip="Functional Threshold Power (W) — highest power you can sustain for ~1 hour"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource LblBikeKg}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtBikeKg" Margin="0,0,0,4"
                               ToolTip="Bike mass in kg (road ≈9, XC ≈12)"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LblCdA}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtCdA" Margin="0,0,0,4"
                               ToolTip="Aerodynamic drag area (m²). Road hoods ≈0.32, drops ≈0.26, XC ≈0.45"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,4" Text="Preset:"/>
                    <ComboBox  Grid.Row="1" Grid.Column="4" x:Name="CmbCdAPreset" Margin="0,0,0,4"
                               SelectionChanged="CmbCdAPreset_SelectionChanged">
                        <ComboBoxItem Content="Road / hoods (0.32)" Tag="0.32"/>
                        <ComboBoxItem Content="Road / drops (0.26)" Tag="0.26"/>
                        <ComboBoxItem Content="XC / MTB (0.45)" Tag="0.45"/>
                        <ComboBoxItem Content="Aero / TT (0.21)" Tag="0.21"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LblCrr}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCrr" Margin="0,0,0,4"
                               ToolTip="Rolling resistance coefficient. Asphalt ≈0.004, gravel ≈0.008, XC trail ≈0.012"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,4" Text="Preset:"/>
                    <ComboBox  Grid.Row="2" Grid.Column="4" x:Name="CmbCrrPreset" Margin="0,0,0,4"
                               SelectionChanged="CmbCrrPreset_SelectionChanged">
                        <ComboBoxItem Content="Asphalt (0.004)" Tag="0.004"/>
                        <ComboBoxItem Content="Gravel (0.008)" Tag="0.008"/>
                        <ComboBoxItem Content="XC trail (0.012)" Tag="0.012"/>
                    </ComboBox>
                </Grid>
            </Expander>
            <CheckBox x:Name="ChkUsePhysics" Content="{DynamicResource ChkUsePhysics}"
                      Margin="0,4,0,0" Visibility="Collapsed"
                      Checked="ChkUsePhysics_Changed" Unchecked="ChkUsePhysics_Changed"
                      ToolTip="Physics model requires FTP in the cycling section above. Works without a fitted model."/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="RunButton" Content="{DynamicResource BtnPredict}" Width="100" Click="Run_Click" IsEnabled="False"/>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{DynamicResource LblPrediction}" FontWeight="Bold" Margin="0,4,0,4"/>

        <TextBox x:Name="ReportText" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Background="#FAFAFA"
                 Text="{DynamicResource ApplyInitialText}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="{DynamicResource BtnAddPredicted}" Width="150" IsEnabled="False" Click="Add_Click"/>
            <Button Content="{DynamicResource BtnCancel}" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
