<Window x:Class="TrackEditor.ServerTracksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server Tracks" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="_Close" Width="80" IsCancel="True"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11" Foreground="#555"/>

        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="135">
            <Button x:Name="BtnRefresh" Content="Refresh" Margin="0,0,0,6" Click="Refresh_Click"/>
            <Separator Margin="0,2,0,6"/>
            <Button x:Name="BtnOpen" Content="Open Track" Margin="0,0,0,6" IsEnabled="False" Click="Open_Click"
                    ToolTip="Load the selected server track into the editor"/>
            <Button x:Name="BtnSaveNew" Content="Save as New" Margin="0,0,0,6" IsEnabled="False" Click="SaveNew_Click"
                    ToolTip="Upload the active editor track to the server as a new entry"/>
            <Button x:Name="BtnUpdate" Content="Update Selected" Margin="0,0,0,6" IsEnabled="False" Click="Update_Click"
                    ToolTip="Overwrite the selected server track with the active editor track"/>
            <Separator Margin="0,2,0,6"/>
            <Button x:Name="BtnDelete" Content="Delete" Margin="0,0,0,6" IsEnabled="False" Click="Delete_Click"/>
            <Separator Margin="0,2,0,6"/>
            <Button x:Name="BtnShare" Content="Share" Margin="0,0,0,6" IsEnabled="False" Click="Share_Click"
                    ToolTip="Make this track publicly accessible by ID"/>
            <Button x:Name="BtnUnshare" Content="Unshare" IsEnabled="False" Click="Unshare_Click"
                    ToolTip="Revoke public access to this track"/>
        </StackPanel>

        <ListView x:Name="TrackList" SelectionChanged="TrackList_SelectionChanged"
                  MouseDoubleClick="TrackList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Updated" Width="135" DisplayMemberBinding="{Binding UpdatedText}"/>
                    <GridViewColumn Header="Shared" Width="55" DisplayMemberBinding="{Binding SharedText}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
