<Window x:Class="TrackEditor.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HelpTitle}" Height="760" Width="860"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F5F5F7" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Padding="10,6">
            <Button Content="{DynamicResource BtnClose}" Width="80" HorizontalAlignment="Right" Click="Close_Click"/>
        </Border>
        <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto"
                                  IsToolBarVisible="False" Padding="0"/>
    </DockPanel>
</Window>
