<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- SkiaSharp-based map image export. Referenced by the WPF app and (optionally) the server;
       NOT by the WASM bundle. -->
  <ItemGroup>
    <PackageReference Include="Mapsui" Version="5.1.0" />
    <PackageReference Include="BruTile" Version="6.0.0" />
    <PackageReference Include="ShimSkiaSharp" Version="3.2.1" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrackEditor.Core\TrackEditor.Core.csproj" />
  </ItemGroup>

</Project>
